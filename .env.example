# Chave da API da OpenAI. Obtenha em https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Porta do servidor (opcional)
PORT=3000

# Modelo OpenAI (opcional — padrão: gpt-4o).
# Sugestões: gpt-4o, gpt-4.1 (contexto maior, melhor p/ contratos longos),
# gpt-5, o3, o4-mini (modelos de raciocínio).
OPENAI_MODEL=gpt-4o

# (Opcional) Base URL alternativa — ex.: Azure OpenAI ou gateway compatível.
# OPENAI_BASE_URL=https://api.openai.com/v1

# (Opcional) Esforço de raciocínio para modelos o-series / gpt-5: low | medium | high
# OPENAI_REASONING_EFFORT=medium
